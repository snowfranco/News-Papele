# Superlearn / manifold secrets. Copy to .env at the repo root and fill in.
# .env is gitignored (the .env* rule); never commit real values.
#
# The app itself (the cockpit) needs NONE of these: it ships the public anon
# key in src/config.ts and runs from the static build. These variables are for
# manifold, the editor agent (manifold/README.md). On GitHub Actions they come
# from repository secrets and variables, not this file.

# --- Supabase ------------------------------------------------------------

# Superlearn's Supabase project. Not secret; defaults to the live project if
# unset (manifold/src/env.ts).
SUPABASE_URL=https://gijdjbjycymqsuhwfcbu.supabase.co

# Write access for manifold. The service role key is the intended credential
# (Supabase dashboard: Project Settings, API, service_role). It bypasses RLS;
# keep it here only, never in the app bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Stopgap only: the app's public anon key also works today because every
# Superlearn table ships an allow-all RLS policy
# (supabase/migrations/20260804000000_superlearn.sql). The moment those
# policies tighten, the anon key stops writing and the service key is required.
SUPABASE_ANON_KEY=

# --- Model (BYOK) --------------------------------------------------------

# Bring your own Anthropic key. Required for the editorial pass and the evals
# judge. This is the only model auth v1 supports; the call is wrapped in one
# narrow interface so a proxy or hosted key can be added later without a
# rewrite (manifold/src/claude.ts, docs/adr/0001-manifold-runtime.md). With no
# key set, manifold falls back to the local `claude` CLI, which is a
# local-dev-only convenience and is never available on the GitHub runner.
ANTHROPIC_API_KEY=

# Model for the editorial pass and the evals judge (judge overridable with
# MANIFOLD_JUDGE_MODEL). Sonnet-tier default.
MANIFOLD_MODEL=claude-sonnet-5

# --- Tuning (all optional; defaults in manifold/src/env.ts) --------------

# MANIFOLD_ITEM_CAP=120
# MANIFOLD_MAX_ATTEMPTS=2
# MANIFOLD_JUDGE_MODEL=
# SUPERLEARN_TENANT=default
# Rolling window (days) in which an outbox park excludes its items from lede
# and start_here candidacy.
# MANIFOLD_PARK_WINDOW_DAYS=90
# Below this many viable (non-excluded) items, the editorial prompt asks for a
# smaller honest edition instead of padding.
# MANIFOLD_EDITION_FLOOR=3
